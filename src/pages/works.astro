---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Works" description="鈴木愛美の映像制作・スピーチライター作品一覧">
  <div class="page-header">
    <div class="page-header-inner">
      <p class="page-eyebrow">Works</p>
      <h1>作品集</h1>
    </div>
  </div>

  <div class="page-wrapper">
    <div class="filter-tabs">
      <button class="filter-btn active" data-filter="all">すべて</button>
      <button class="filter-btn" data-filter="video">映像制作</button>
      <button class="filter-btn" data-filter="speech">スピーチ・執筆</button>
      <button class="filter-btn" data-filter="training">スピーチトレーニング</button>
    </div>

    <div class="works-grid">
      <a class="work-card" data-category="video" href="https://www.youtube.com/watch?v=vJIjISpn6wY" target="_blank" rel="noopener noreferrer">
        <div class="work-thumb yt-thumb">
          <img src="https://img.youtube.com/vi/vJIjISpn6wY/maxresdefault.jpg" alt="スピーチライター" />
          <div class="yt-play">
            <svg viewBox="0 0 68 48" width="60" height="42"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#ff0000"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
          </div>
        </div>
        <div class="work-info">
          <span class="work-tag tag-video">映像制作</span>
          <h3>スピーチライター</h3>
          <p>企画・製作</p>
        </div>
      </a>
      <a class="work-card" data-category="video" href="https://youtu.be/vaqpUTTNJ64" target="_blank" rel="noopener noreferrer">
        <div class="work-thumb yt-thumb">
          <img src="https://img.youtube.com/vi/vaqpUTTNJ64/maxresdefault.jpg" alt="THE FINAL CRUMB ~Three Cookies~" />
          <div class="yt-play">
            <svg viewBox="0 0 68 48" width="60" height="42"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#ff0000"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
          </div>
        </div>
        <div class="work-info">
          <span class="work-tag tag-video">映像制作</span>
          <h3>THE FINAL CRUMB ~Three Cookies~</h3>
          <p>Higgsfield主催コンテスト "Global Teams Challenge" 応募作品。制作と編集を担当。</p>
        </div>
      </a>
      <a class="work-card" data-category="video" href="https://www.youtube.com/watch?v=oFlXafduPw0" target="_blank" rel="noopener noreferrer">
        <div class="work-thumb yt-thumb">
          <img src="https://img.youtube.com/vi/oFlXafduPw0/maxresdefault.jpg" alt="Generate Summer" />
          <div class="yt-play">
            <svg viewBox="0 0 68 48" width="60" height="42"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#ff0000"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
          </div>
        </div>
        <div class="work-info">
          <span class="work-tag tag-video">映像制作</span>
          <h3>Generate Summer</h3>
          <p>AI gekijjo 2025（2025年8月10日開催）に提出したチーム制作映像。演出を担当。</p>
        </div>
      </a>
      <a class="work-card" data-category="training" href="https://youtube.com/shorts/s3hvy0O220U" target="_blank" rel="noopener noreferrer">
        <div class="work-thumb yt-thumb">
          <img src="https://img.youtube.com/vi/s3hvy0O220U/maxresdefault.jpg" alt="90分スピーチトレーニング①" />
          <div class="yt-play">
            <svg viewBox="0 0 68 48" width="60" height="42"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#ff0000"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
          </div>
        </div>
        <div class="work-info">
          <h3>90分スピーチトレーニング①</h3>
        </div>
      </a>
      <div class="work-card" data-category="speech">
        <div class="work-thumb placeholder-thumb">
          <span>✍️</span>
        </div>
        <div class="work-info">
          <span class="work-tag tag-speech">スピーチ・執筆</span>
          <h3>スピーチタイトル</h3>
          <p>スピーチ・執筆物の概要がここに入ります。</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.work-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      cards.forEach(card => {
        card.style.display =
          filter === 'all' || card.dataset.category === filter ? '' : 'none';
      });
    });
  });
</script>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--navy-dark) 0%, var(--navy) 100%);
    padding: 3.5rem 1.5rem 3rem;
    color: var(--white);
  }
  .page-header-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .page-eyebrow {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }
  .page-header h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .page-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .filter-tabs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2.75rem;
    flex-wrap: wrap;
  }
  .filter-btn {
    padding: 0.5rem 1.4rem;
    border: 1.5px solid var(--border);
    background: var(--white);
    border-radius: 2rem;
    cursor: pointer;
    font-size: 0.85rem;
    font-family: inherit;
    color: var(--text-mid);
    transition: all 0.2s;
    letter-spacing: 0.04em;
  }
  .filter-btn.active,
  .filter-btn:hover {
    background: var(--navy);
    color: var(--white);
    border-color: var(--navy);
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }
  .work-card {
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--white);
    transition: box-shadow 0.2s, transform 0.2s;
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .work-card:hover {
    box-shadow: 0 6px 24px rgba(29,53,87,0.12);
    transform: translateY(-3px);
  }
  .placeholder-thumb {
    height: 210px;
    background: var(--bg-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    border-bottom: 1px solid var(--border);
  }
  .yt-thumb {
    height: 210px;
    position: relative;
    overflow: hidden;
    background: #000;
  }
  .yt-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, opacity 0.3s;
  }
  .work-card:hover .yt-thumb img {
    transform: scale(1.05);
    opacity: 0.85;
  }
  .yt-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .yt-play svg {
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5));
    transition: transform 0.2s;
  }
  .work-card:hover .yt-play svg {
    transform: scale(1.12);
  }
  .work-info {
    padding: 1.4rem 1.25rem;
  }
  .work-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.7rem;
    border-radius: 2px;
    margin-bottom: 0.6rem;
    letter-spacing: 0.06em;
  }
  .tag-video    { background: var(--navy);       color: var(--white); }
  .tag-speech   { background: var(--blue-accent); color: var(--white); }
  .tag-training { background: #5a7a5a;            color: var(--white); }
  .work-info h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }
  .work-info p {
    font-size: 0.88rem;
    color: var(--text-mid);
    line-height: 1.7;
  }
</style>
