---
import BaseLayout from '../layouts/BaseLayout.astro';

const videoWorks = [
  {
    client: 'キャリア支援企業',
    title: '利用者インタビュー動画',
    desc: 'サービス利用者へのインタビュー取材と動画編集を担当しました。',
    tags: ['取材・インタビュー', '動画編集'],
  },
  {
    client: '大手教育グループ会社',
    title: '社内報動画の編集',
    desc: '企業理念の浸透と社内文化の醸成を目的とした社内報動画の編集を担当しました。',
    tags: ['動画編集'],
  },
  {
    client: '金融関連会社',
    title: '社内報動画の編集',
    desc: '企業理念の浸透と社内文化の醸成を目的とした社内報動画の編集を担当しました。',
    tags: ['動画編集'],
  },
  {
    client: '大手ITソリューション企業',
    title: '式典用プレゼンテーション背景・トランジションの作成',
    desc: '5000人規模の式典における、プレゼンテーションの背景アニメーション・トランジションの作成を担当しました。',
    tags: ['モーショングラフィックス', '映像制作'],
  },
  {
    client: '大手教育グループ会社',
    title: '総会プレゼンテーション用 事業紹介動画の編集',
    desc: '数百名規模の総会における、プレゼンテーション用の事業紹介動画の編集を担当しました。',
    tags: ['動画編集', '映像制作'],
  },
  {
    client: '不動産関連サポート会社',
    title: 'デジタルサイネージ動画の作成',
    desc: '本社ビル前に設置されている、デジタルサイネージ用広告動画の作成を担当しました。',
    tags: ['映像制作', 'デジタルサイネージ'],
  },
];

const writingWorks = [
  {
    client: '化粧品会社',
    title: 'エグゼクティブスピーチ原稿執筆',
    desc: 'チーム向けリーダースピーチの原稿を執筆しました。',
    tags: ['スピーチライティング', '原稿執筆'],
  },
  {
    client: '飲食店オーナー（個人）',
    title: '学生向けスピーチ原稿執筆',
    desc: '学生に向けた講演スピーチの原稿を執筆しました。',
    tags: ['スピーチライティング', '原稿執筆'],
  },
  {
    client: 'スポーツクラブ（50周年）',
    title: '記念冊子 挨拶文執筆',
    desc: '創立50周年記念冊子の責任者挨拶文を執筆しました。',
    tags: ['スピーチライティング', '原稿執筆'],
  },
  {
    client: 'ヒモンスピーチ',
    title: '講師挨拶スピーチ原稿',
    desc: 'あがり症の方向けスピーチ練習会「ヒモンスピーチ」での2分間挨拶スピーチ原稿。参加者が前向きに取り組めるよう意図して執筆しました。',
    tags: ['スピーチライティング', '原稿執筆'],
    link: 'https://note.com/ami_su/n/n419ac3eff26f',
  },
  {
    client: '不動産関連サポート会社',
    title: '採用向け社員インタビュー（記事・漫画・漫画の動画化）',
    desc: '採用強化を目的とした、社員インタビュー記事の作成を担当しました。記事制作に加え、漫画化・動画化まで一貫して携わりました。',
    tags: ['取材・インタビュー', '記事執筆', '漫画制作', '動画化'],
  },
  {
    client: '不動産関連サポート会社',
    title: '社史執筆',
    desc: '創業者や社員へのインタビューを行い、社史を執筆しました。',
    tags: ['取材・インタビュー', '執筆'],
  },
];
---

<BaseLayout title="Works" description="鈴木愛美の映像制作・スピーチライター作品一覧">
  <div class="page-header">
    <div class="page-header-inner">
      <p class="page-eyebrow">Works</p>
      <h1>制作実績</h1>
    </div>
  </div>

  <div class="page-wrapper">

    <p class="lead-text">取材・インタビュー・執筆・映像制作まで、さまざまな業界の企業案件に携わってきました。</p>

    <!-- 実績 -->
    <section class="achievements">

      <div class="filter-tabs achiev-filter-tabs">
        <button class="filter-btn achiev-btn active" data-achiev="all">すべて</button>
        <button class="filter-btn achiev-btn" data-achiev="video">映像・動画制作</button>
        <button class="filter-btn achiev-btn" data-achiev="writing">ライティング・コンテンツ制作</button>
        <button class="filter-btn achiev-btn" data-achiev="training">スピーチトレーニング</button>
      </div>

      <!-- 映像・動画制作 -->
      <div class="achievement-block" data-achiev="video">
        <h2 class="achievement-heading">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="6" width="15" height="12" rx="2"/>
            <path d="M17 10l5-3v10l-5-3"/>
          </svg>
          映像・動画制作
        </h2>
        <ul class="achievement-list">
          {videoWorks.map(item => (
            <li class="achievement-card">
              <h3 class="card-title">
                <span class="card-client">{item.client}</span>
                <span class="card-sep">｜</span>
                <span class="card-work">{item.title}</span>
              </h3>
              <p class="card-desc">{item.desc}</p>
              <div class="card-tags">
                {item.tags.map(tag => <span class="card-tag">{tag}</span>)}
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- ライティング・コンテンツ制作 -->
      <div class="achievement-block" data-achiev="writing">
        <h2 class="achievement-heading">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9"/>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
          </svg>
          ライティング・コンテンツ制作
        </h2>
        <ul class="achievement-list">
          {writingWorks.map(item => (
            <li class="achievement-card">
              <h3 class="card-title">
                <span class="card-client">{item.client}</span>
                <span class="card-sep">｜</span>
                <span class="card-work">{item.title}</span>
              </h3>
              <p class="card-desc">{item.desc}</p>
              <div class="card-tags">
                {item.tags.map(tag => <span class="card-tag">{tag}</span>)}
              </div>
              {item.link && (
                <a class="card-link" href={item.link} target="_blank" rel="noopener noreferrer">
                  noteで読む →
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- スピーチトレーニング -->
      <div class="achievement-block" data-achiev="training">
        <h2 class="achievement-heading">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
            <line x1="12" y1="19" x2="12" y2="23"/>
            <line x1="8" y1="23" x2="16" y2="23"/>
          </svg>
          スピーチトレーニング
        </h2>
        <ul class="achievement-list">
          <li class="achievement-card">
            <h3 class="card-title">
              <span class="card-work">90分スピーチトレーニング①</span>
            </h3>
            <p class="card-desc">90分の個人トレーニングの様子です。</p>
            <div class="card-tags">
              <span class="card-tag">スピーチトレーニング</span>
            </div>
            <a class="card-link" href="https://youtube.com/shorts/s3hvy0O220U" target="_blank" rel="noopener noreferrer">
              YouTubeで見る →
            </a>
          </li>
        </ul>
      </div>

      <p class="achievement-footnote">※ 掲載案件はチームの一員として制作に携わったものを含みます。</p>
    </section>

    <!-- 自主制作 -->
    <div class="section-divider">
      <span class="divider-label">自主制作</span>
    </div>

    <div class="filter-tabs">
      <button class="filter-btn active" data-filter="all">すべて</button>
      <button class="filter-btn" data-filter="video">映像制作</button>
      <button class="filter-btn" data-filter="speech">スピーチ・執筆</button>
    </div>

    <div class="works-grid">
      <a class="work-card" data-category="video" href="https://www.youtube.com/watch?v=vJIjISpn6wY" target="_blank" rel="noopener noreferrer">
        <div class="work-thumb yt-thumb">
          <img src="https://img.youtube.com/vi/vJIjISpn6wY/maxresdefault.jpg" alt="スピーチライター" />
          <div class="yt-play">
            <svg viewBox="0 0 68 48" width="60" height="42"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#ff0000"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
          </div>
        </div>
        <div class="work-info">
          <span class="work-tag tag-video">映像制作</span>
          <h3>スピーチライター</h3>
          <p>企画・製作</p>
        </div>
      </a>
      <a class="work-card" data-category="video" href="https://youtu.be/vaqpUTTNJ64" target="_blank" rel="noopener noreferrer">
        <div class="work-thumb yt-thumb">
          <img src="https://img.youtube.com/vi/vaqpUTTNJ64/maxresdefault.jpg" alt="THE FINAL CRUMB ~Three Cookies~" />
          <div class="yt-play">
            <svg viewBox="0 0 68 48" width="60" height="42"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#ff0000"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
          </div>
        </div>
        <div class="work-info">
          <span class="work-tag tag-video">映像制作</span>
          <h3>THE FINAL CRUMB ~Three Cookies~</h3>
          <p>Higgsfield主催コンテスト "Global Teams Challenge" 応募作品。制作と編集を担当。</p>
        </div>
      </a>
      <a class="work-card" data-category="video" href="https://www.youtube.com/watch?v=oFlXafduPw0" target="_blank" rel="noopener noreferrer">
        <div class="work-thumb yt-thumb">
          <img src="https://img.youtube.com/vi/oFlXafduPw0/maxresdefault.jpg" alt="Generate Summer" />
          <div class="yt-play">
            <svg viewBox="0 0 68 48" width="60" height="42"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#ff0000"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
          </div>
        </div>
        <div class="work-info">
          <span class="work-tag tag-video">映像制作</span>
          <h3>Generate Summer</h3>
          <p>AI gekijjo 2025（2025年8月10日開催）に提出したチーム制作映像。演出を担当。</p>
        </div>
      </a>
      <a class="work-card" data-category="speech" href="https://note.com/ami_su/n/n21c264b4b964" target="_blank" rel="noopener noreferrer">
        <div class="work-thumb note-thumb">
          <span class="note-badge">note</span>
          <p class="note-title-preview">スピーチライターゼミ<br />ライティング部テーマ『直島』</p>
        </div>
        <div class="work-info">
          <span class="work-tag tag-speech">スピーチ・執筆</span>
          <h3>スピーチライターゼミ<br />ライティング部テーマ『直島』</h3>
        </div>
      </a>
    </div>

  </div>
</BaseLayout>

<script>
  // 自主制作フィルター
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn:not(.achiev-btn)');
  const workCards = document.querySelectorAll<HTMLElement>('.work-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      workCards.forEach(card => {
        card.style.display =
          filter === 'all' || card.dataset.category === filter ? '' : 'none';
      });
    });
  });

  // 実績フィルター
  const achievBtns = document.querySelectorAll<HTMLButtonElement>('.achiev-btn');
  const achievBlocks = document.querySelectorAll<HTMLElement>('.achievement-block');

  achievBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      achievBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.achiev;
      achievBlocks.forEach(block => {
        block.style.display =
          filter === 'all' || block.dataset.achiev === filter ? '' : 'none';
      });
    });
  });
</script>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--navy-dark) 0%, var(--navy) 100%);
    padding: 3.5rem 1.5rem 3rem;
    color: var(--white);
  }
  .page-header-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .page-eyebrow {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }
  .page-header h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .page-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  /* Lead */
  .lead-text {
    font-size: 0.95rem;
    line-height: 1.9;
    color: var(--text-mid);
    border-left: 3px solid var(--gold);
    padding-left: 1.2rem;
    margin-bottom: 3rem;
  }

  /* Achievements */
  .achievements {
    margin-bottom: 3.5rem;
  }
  .achiev-filter-tabs {
    margin-bottom: 2rem;
  }
  .achievement-block {
    margin-bottom: 3rem;
  }
  .achievement-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-mid);
    letter-spacing: 0.06em;
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .achievement-heading svg {
    color: var(--text-mid);
    flex-shrink: 0;
  }

  .achievement-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .achievement-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.4rem 1.6rem 1.3rem;
    transition: box-shadow 0.2s;
  }
  .achievement-card:hover {
  }
  .card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.55rem;
    line-height: 1.5;
  }
  .card-client {
    /* inherits */
  }
  .card-sep {
    color: var(--text-light);
    margin: 0 0.2rem;
  }
  .card-work {
    /* inherits */
  }
  .card-desc {
    font-size: 0.875rem;
    color: var(--text-mid);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .card-tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 2rem;
    color: var(--text-mid);
    letter-spacing: 0.03em;
  }
  .card-link {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.8rem;
    color: var(--blue-accent);
    text-decoration: none;
    letter-spacing: 0.03em;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .card-link:hover {
    border-bottom-color: var(--blue-accent);
  }
  .achievement-footnote {
    font-size: 0.8rem;
    color: var(--text-light);
    margin-top: -1rem;
  }

  /* Section divider */
  .section-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .section-divider::before,
  .section-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .divider-label {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--text-light);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Filter */
  .filter-tabs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2.75rem;
    flex-wrap: wrap;
  }
  .filter-btn {
    padding: 0.5rem 1.4rem;
    border: 1.5px solid var(--border);
    background: var(--white);
    border-radius: 2rem;
    cursor: pointer;
    font-size: 0.85rem;
    font-family: inherit;
    color: var(--text-mid);
    transition: all 0.2s;
    letter-spacing: 0.04em;
  }
  .filter-btn.active,
  .filter-btn:hover {
    background: var(--navy);
    color: var(--white);
    border-color: var(--navy);
  }

  /* Works grid */
  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }
  .work-card {
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--white);
    transition: box-shadow 0.2s, transform 0.2s;
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .work-card:hover {
    box-shadow: 0 6px 24px rgba(29, 53, 87, 0.12);
    transform: translateY(-3px);
  }
  .yt-thumb {
    height: 210px;
    position: relative;
    overflow: hidden;
    background: #000;
  }
  .yt-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, opacity 0.3s;
  }
  .work-card:hover .yt-thumb img {
    transform: scale(1.05);
    opacity: 0.85;
  }
  .yt-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .yt-play svg {
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.5));
    transition: transform 0.2s;
  }
  .work-card:hover .yt-play svg {
    transform: scale(1.12);
  }
  .work-info {
    padding: 1.4rem 1.25rem;
  }
  .work-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.7rem;
    border-radius: 2px;
    margin-bottom: 0.6rem;
    letter-spacing: 0.06em;
  }
  .tag-video    { background: var(--navy);        color: var(--white); }
  .tag-speech   { background: var(--blue-accent);  color: var(--white); }
  .tag-training { background: #5a7a5a;             color: var(--white); }

  /* Note card thumbnail */
  .note-thumb {
    height: 210px;
    background: #f7f5f0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 2rem;
    position: relative;
  }
  .note-badge {
    position: absolute;
    top: 1rem;
    left: 1.2rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #41c9b4;
    letter-spacing: 0.12em;
  }
  .note-title-preview {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--navy);
    text-align: center;
    line-height: 1.7;
  }
  .work-info h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }
  .work-info p {
    font-size: 0.88rem;
    color: var(--text-mid);
    line-height: 1.7;
  }
</style>
